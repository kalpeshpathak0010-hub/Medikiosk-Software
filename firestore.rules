rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper authentication functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return exists(/databases/$(database)/documents/staff_profiles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/staff_profiles/$(request.auth.uid)).data.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          : (request.auth.token.role != null ? request.auth.token.role : 'PATIENT'));
    }
    
    function isStaff() {
      return isSignedIn() && (
        getUserRole() == 'DOCTOR' || getUserRole() == 'doctor' ||
        getUserRole() == 'physician' || getUserRole() == 'PHYSICIAN' ||
        getUserRole() == 'ADMIN' || getUserRole() == 'admin'
      );
    }
    
    function isDoctor() {
      return isSignedIn() && (
        getUserRole() == 'DOCTOR' || getUserRole() == 'doctor' ||
        getUserRole() == 'physician' || getUserRole() == 'PHYSICIAN'
      );
    }
    
    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'ADMIN' || getUserRole() == 'admin');
    }

    // Hospitals
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Staff Profiles Collection (canonical physician & admin profiles)
    match /staff_profiles/{profileId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Users Collection (profiles & staff records)
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Patients Collection (Public OPD Kiosk & Doctor View)
    match /patients/{patientId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Encounters / OPD Visits
    match /encounters/{encounterId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Clinical Sessions (Multi-device OPD Queue)
    match /clinicalSessions/{sessionId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Clinical History (Session-linked)
    match /clinicalHistory/{sessionId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Red Flag Assessments (Session-linked)
    match /redFlagAssessments/{sessionId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Clinical Histories (legacy and extended)
    match /clinicalHistories/{historyId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // AYUSH Pariksha Assessments
    match /ayushAssessments/{assessmentId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Medical Documents Metadata
    match /documents/{docId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // OCR Results
    match /ocrResults/{ocrId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Clinical Summaries
    match /clinicalSummaries/{summaryId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Physician Reviews & Edits
    match /physicianReviews/{reviewId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Sign-Off Records
    match /signOffs/{signOffId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // FHIR R4 Diagnostic Reports
    match /diagnosticReports/{reportId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Audit Logs (Immutable append-only)
    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
  }
}
